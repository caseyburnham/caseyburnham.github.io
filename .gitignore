# Ignore OS generated files
.DS_Store
Thumbs.db
.nova

# Generated CSS
css/dist/

# Generated development JavaScript
js/dist/

# Compiled source #
*.class
*.o
*.so

# Node modules
node_modules/
stylelintrc.json

# Python
__pycache__/
*.pyc
venv/

# Log files
*.log

# Build artifacts
/dist/
/build/
/.dist-previous/
/playwright-report/
/test-results/

# Environment variables (dangerous!)
.env

# Old Files
old/

# Local high-resolution sources
images/galleries/*/ORIGINALS/
images/summits/ORIGINALS/

# Local Netlify folder
.netlify
