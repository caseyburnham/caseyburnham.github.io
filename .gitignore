# Ignore OS generated files
.DS_Store
Thumbs.db
.nova

# Generated CSS
css/dist/

# Compiled source #
*.class
*.o
*.so

# Node modules
node_modules/
stylelintrc.json

# Local content utilities
utility/*
!utility/postcss.config.js
update-gal.zsh

# Python
__pycache__/
*.pyc
venv/

# Log files
*.log

# Build artifacts
/dist/
/build/

# Environment variables (dangerous!)
.env

# Old Files
old/

# Local high-resolution sources
images/galleries/*/ORIGINALS/
images/summits/ORIGINALS/

# Local Netlify folder
.netlify
