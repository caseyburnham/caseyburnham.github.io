/*
  # Security Headers
  
  # HSTS - Force HTTPS (2 years, include subdomains, allow preload)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # Prevent browsers from MIME-sniffing
  X-Content-Type-Options: nosniff
  
  # XSS Protection (legacy, but doesn't hurt)
  X-XSS-Protection: 1; mode=block
  
  # Clickjacking protection
  X-Frame-Options: DENY
  
  # Referrer policy - don't leak URLs when navigating away
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions policy - disable unused browser features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  
  # Cross-Origin policies (relaxed for external APIs)
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.maptiler.com https://api.discogs.com https://*.maptiler.com https://*.netlify.app; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Content-hashed build assets are safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
