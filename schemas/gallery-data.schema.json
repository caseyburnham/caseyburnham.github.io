{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Gallery data",
	"type": "object",
	"required": ["_config"],
	"properties": {
		"_config": {
			"type": "object",
			"additionalProperties": false,
			"required": ["defaultGallery"],
			"properties": {
				"defaultGallery": { "type": "string", "pattern": "^[a-z0-9-]+$" }
			}
		}
	},
	"patternProperties": {
		"^(?!_config$)[a-z0-9-]+$": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "images"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"images": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/image" }
				}
			}
		}
	},
	"additionalProperties": false,
	"definitions": {
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "alt", "title", "dateCreated", "copyrightNotice", "layout", "sources", "thumbnail"],
			"properties": {
				"id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9,&@'-]*$" },
				"alt": { "type": "string", "minLength": 1 },
				"title": { "type": "string", "minLength": 1 },
				"dateCreated": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$" },
				"copyrightNotice": { "type": "string", "minLength": 1 },
				"layout": { "enum": ["landscape", "portrait", "pano"] },
				"sources": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"additionalProperties": false,
					"properties": {
						"avif": { "type": "string", "pattern": "^/images/galleries/.+/avif/.+\\.avif$" },
						"jpeg": { "type": "string", "pattern": "^/images/galleries/.+/jpeg/.+\\.jpe?g$" },
						"png": { "type": "string", "pattern": "^/images/galleries/.+/png/.+\\.png$" }
					}
				},
				"thumbnail": { "type": "string", "pattern": "^/images/galleries/.+/thumbnails/.+\\.(avif|jpe?g|png)$" }
			}
		}
	}
}
