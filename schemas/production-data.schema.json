{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Production data",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["Production", "Company", "A1", "A2", "SD", "AD", "LZ", "Notes"],
		"properties": {
			"Production": { "type": "string", "minLength": 1 },
			"Company": { "type": "string", "minLength": 1 },
			"A1": { "type": "string" },
			"A2": { "type": "string" },
			"SD": { "type": "string" },
			"AD": { "type": "string" },
			"LZ": { "type": "string" },
			"Notes": { "type": "string" }
		}
	}
}
