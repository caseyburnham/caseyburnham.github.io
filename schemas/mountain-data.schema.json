{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Mountain data",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["Peak", "Elevation", "Range", "Date", "Image", "ranked"],
		"properties": {
			"Peak": { "type": "string", "minLength": 1 },
			"Elevation": { "type": "string", "pattern": "^[0-9]{2},[0-9]{3}$" },
			"Range": { "type": "string", "minLength": 1 },
			"Date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
			"Image": { "type": "string", "pattern": "^/images/summits/.+\\.(avif|jpe?g|png)$" },
			"ranked": { "type": "boolean" }
		}
	}
}
