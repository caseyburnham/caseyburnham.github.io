{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "EXIF data",
	"type": "object",
	"propertyNames": {
		"pattern": "^(galleries/.+|summits/.+)\\.(avif|jpe?g|png)$"
	},
	"additionalProperties": { "$ref": "#/definitions/exif" },
	"definitions": {
		"exif": {
			"type": "object",
			"additionalProperties": false,
			"required": ["title", "caption", "copyright", "cameraModel", "iso", "lens", "aperture", "shutter", "exposureCompensation", "date", "format"],
			"properties": {
				"title": { "type": ["string", "null"] },
				"caption": { "type": ["string", "null"] },
				"copyright": { "type": "string" },
				"cameraModel": { "type": "string" },
				"iso": { "type": "number", "minimum": 0 },
				"lens": { "type": ["number", "null"], "minimum": 0 },
				"aperture": { "type": ["number", "null"], "minimum": 0 },
				"shutter": { "type": "string" },
				"exposureCompensation": { "type": "string" },
				"date": { "$ref": "#/definitions/date" },
				"format": { "enum": ["AVIF", "JPEG", "PNG"] },
				"gps": { "$ref": "#/definitions/gps" }
			}
		},
		"date": {
			"type": "object",
			"additionalProperties": false,
			"required": ["_ctor", "year", "month", "day", "hour", "minute", "second", "tzoffsetMinutes", "rawValue", "zoneName", "inferredZone"],
			"properties": {
				"_ctor": { "const": "ExifDateTime" },
				"year": { "type": "integer", "minimum": 1900 },
				"month": { "type": "integer", "minimum": 1, "maximum": 12 },
				"day": { "type": "integer", "minimum": 1, "maximum": 31 },
				"hour": { "type": "integer", "minimum": 0, "maximum": 23 },
				"minute": { "type": "integer", "minimum": 0, "maximum": 59 },
				"second": { "type": "integer", "minimum": 0, "maximum": 60 },
				"tzoffsetMinutes": { "type": "integer" },
				"rawValue": { "type": "string" },
				"zoneName": { "type": "string" },
				"inferredZone": { "type": "boolean" }
			}
		},
		"gps": {
			"type": "object",
			"additionalProperties": false,
			"required": ["lat", "lon", "latDMS", "lonDMS", "alt", "altRef"],
			"properties": {
				"lat": { "type": "number", "minimum": -90, "maximum": 90 },
				"lon": { "type": "number", "minimum": -180, "maximum": 180 },
				"latDMS": { "type": "string" },
				"lonDMS": { "type": "string" },
				"alt": { "type": ["number", "null"] },
				"altRef": { "type": "integer" }
			}
		}
	}
}
